# =========================================================
# CAREGRAPH AI - ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================

# 1. MURF AI (Sub-250ms Falcon Indian Voice TTS Engine)
# Get from: https://murf.ai -> Settings -> API Keys
MURF_API_KEY=your_murf_api_key_here

# 2. DEEPGRAM (Nova-2 Bilingual Hindi/English Speech-to-Text)
# Get from: https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# 3. TWILIO TELEPHONY (Automated Emergency Hospital CAD Dialer)
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# 4. LIVEKIT WEBRTC (Real-Time Bidirectional Voice Audio Waveform)
# Get from: https://cloud.livekit.io
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# 5. FALKORDB / REDIS (Graph Database)
# (Optional) Built-in local persistent graph store runs automatically if not set.
# FALKORDB_URL=redis://localhost:6379
